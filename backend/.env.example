# ==============================================================================
# OraVisionAI — Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in values for your environment.
# NEVER commit .env with real secrets to version control.
# ==============================================================================


# --- Application --------------------------------------------------------------

APP_NAME=OraVisionAI
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO


# --- Database (PostgreSQL) ----------------------------------------------------

DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/oravisionai


# --- Firebase Authentication --------------------------------------------------

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=  # Deprecated (Storage migrated to Supabase)


# --- Supabase Storage ---------------------------------------------------------

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=oravisionai


# --- Screening & Image Uploads ------------------------------------------------

MAX_UPLOAD_SIZE_BYTES=15728640
ALLOWED_IMAGE_MIME_TYPES=["image/jpeg","image/png","image/webp"]
ALLOWED_IMAGE_EXTENSIONS=[".jpg",".jpeg",".png",".webp"]


# --- AI Model Paths ----------------------------------------------------------

AI_MODEL_DIR=ai_models
CLASSIFIER_MODEL_PATH=ai_models/best_7teeth_efficientnetb0_verified.keras
YOLO_MODEL_PATH=ai_models/oravisionai_yolo.pt


# --- Explainable AI (XAI) ----------------------------------------------------

XAI_OCCLUSION_PATCH_SIZE=32
XAI_OCCLUSION_STRIDE=16
XAI_IG_STEPS=25
XAI_SCORECAM_TOP_CHANNELS=16
XAI_DEFAULT_TARGET_LAYER=block6a_expand_conv
XAI_GENERATE_SECONDARY_BY_DEFAULT=false


# --- Stream (Teleconsultation) ------------------------------------------------

STREAM_API_KEY=your_stream_api_key
STREAM_API_SECRET=your_stream_api_secret


# --- CORS ---------------------------------------------------------------------

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
