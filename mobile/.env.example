# Same public Firebase project settings as frontend/.env. Never copy backend secrets here.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional for development: http://YOUR_PC_LAN_IP:8000
# Required in deployed builds: the existing HTTPS backend URL.
EXPO_PUBLIC_API_URL=
